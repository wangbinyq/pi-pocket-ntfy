# Copy to .env locally (chmod 600); never commit it.
POCKET_URL=http://127.0.0.1:8080
POCKET_TOKEN=replace-with-your-pocket-owner-token

# ntfy server origin and the topic that carries both directions.
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=pip
# Access token, when the ntfy server requires one.
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxx

# Defaults: ~/.local/share/pi-pocket-ntfy/state.json, 1500 ms, 3000 chars per published chunk.
# NTFY_STATE_FILE=/absolute/private/state.json
# NTFY_POLL_MS=1500
# NTFY_CHUNK_LIMIT=3000
